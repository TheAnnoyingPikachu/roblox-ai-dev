local cache: { [string]: MeshPart } = {}

-- A new anchored copy of a generated model, scaled by `scale` and standing on `base` (its bottom
-- face sits at base.Y), facing `yaw` degrees.
function Models.spawn(name: string, parent: Instance, base: Vector3, scale: number, yaw: number?): MeshPart?
	local entry = MESHES[name]
	if entry == nil then
		return nil
	end
	local template = cache[name]
	if template == nil then
		local ok, result = pcall(AssetService.CreateMeshPartAsync, AssetService, Content.fromUri(entry.mesh))
		if not ok then
			warn(`[Models] {name} failed to load: {tostring(result)}`)
			return nil
		end
		template = result :: MeshPart
		template.TextureID = entry.texture
		template.Anchored = true
		template.Size = entry.size
		cache[name] = template
	end
	local copy = template:Clone()
	copy.Name = name
	copy.Size = entry.size * scale
	copy.CFrame = CFrame.new(base + Vector3.new(0, copy.Size.Y / 2, 0)) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	copy.Parent = parent
	return copy
end

-- Hundred Demon Night custom Blender models ----------------------------------------------------
-- One table keyed by manifest asset name (src/shared/NightAssets.luau, generated by
-- tools/blender/night/write-assets-module.mjs). An asset without an uploaded model id returns nil
-- at once, so every caller keeps its current visual until the ids are filled in.

local nightTemplates: { [string]: Model | false } = {}
local nightLoading: { [string]: boolean } = {}
-- Client-side VFX clone these from ReplicatedStorage.NightModels (CombatFx.client.luau).
local CLIENT_MODELS = { slash_arc = true, demon_wing = true, wisp = true }

-- Pieces the code colours itself (Blade Art blade, gate neon) stay untextured.
local function tinted(partName: string): boolean
	return string.match(partName, "_blade$") ~= nil or string.match(partName, "_glow$") ~= nil
end

local function textureOf(entry: NightAssets.Asset): string?
	if entry.texture then
		return `rbxassetid://{entry.texture}`
	elseif entry.decal then
		-- The upload could not resolve the decal's image id: read it from the decal itself.
		local ok, loaded = pcall(InsertService.LoadAsset, InsertService, entry.decal)
		local decal = ok and loaded:FindFirstChildWhichIsA("Decal", true)
		return if decal then decal.Texture else nil
	end
	return nil
end

local function loadNight(name: string): Model?
	while nightLoading[name] do
		task.wait()
	end
	local cached = nightTemplates[name]
	if cached ~= nil then
		return cached or nil
	end
	local entry = NightAssets[name]
	if entry == nil or entry.model == nil then
		return nil
	end
	nightLoading[name] = true
	local template: Model? = nil
	local ok, loaded = pcall(InsertService.LoadAsset, InsertService, entry.model)
	if ok then
		local texture = textureOf(entry)
		local model = Instance.new("Model")
		model.Name = name
		for _, d in loaded:GetDescendants() do
			if d:IsA("MeshPart") then
				d.Anchored = true
				if texture and not tinted(d.Name) then
					d.TextureID = texture
				end
				d.Parent = model
			end
		end
		loaded:Destroy()
		if #model:GetChildren() > 0 then
			-- Fit the measured height uniformly, whatever unit scale the importer used, so the
			-- manifest size holds and multi-part models keep their layout.
			local _, extents = model:GetBoundingBox()
			model:ScaleTo(model:GetScale() * entry.size[2] / extents.Y)
			template = model
		else
			warn(`[Models] {name}: model {entry.model} has no MeshParts`)
		end
	else
		warn(`[Models] {name} failed to load: {tostring(loaded)}`)
	end
	nightTemplates[name] = template or false
	nightLoading[name] = nil
	if template and CLIENT_MODELS[name] then
		local shared = ReplicatedStorage:FindFirstChild("NightModels")
		if shared == nil then
			shared = Instance.new("Folder")
			shared.Name = "NightModels"
			shared.Parent = ReplicatedStorage
		end
		template:Clone().Parent = shared
	end
	return template
end

-- Starts loading every uploaded Night model in the background (server start).
function Models.preloadNight()
	for name, entry in NightAssets do
		if entry.model then
			task.spawn(loadNight, name)
		end
	end
end

-- True when `name` is loaded, so spawning it will not yield (enemy spawns inside the tick).
function Models.nightReady(name: string): boolean
	return nightTemplates[name] ~= nil and nightTemplates[name] ~= false
end

-- Moves `model` so its bounding box sits centred on `base` in x/z with its lowest point at
-- base.Y (nothing sinks into the ground), facing `yaw` degrees.
function Models.place(model: Model, base: Vector3, yaw: number?)
	model:PivotTo(CFrame.new(base) * CFrame.Angles(0, math.rad(yaw or 0), 0))
	local box, size = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() + Vector3.new(base.X - box.X, base.Y - (box.Y - size.Y / 2), base.Z - box.Z))
end

-- A new anchored copy of a Night model standing on `base` (see place), or nil while the asset has
-- no uploaded id or failed to load. Yields on the first load of each asset.
function Models.night(name: string, parent: Instance, base: Vector3, yaw: number?, scale: number?): Model?
	local template = loadNight(name)
	if template == nil then
		return nil
	end
	local copy = template:Clone()
	if scale and scale ~= 1 then
		copy:ScaleTo(copy:GetScale() * scale)
	end
	Models.place(copy, base, yaw)
	copy.Parent = parent
	return copy
end

-- The single MeshPart of a one-mesh Night model (skull, hands, wisp, koi), parented to `parent`.
function Models.nightPart(name: string, parent: Instance, base: Vector3, yaw: number?, scale: number?): MeshPart?
	local model = Models.night(name, parent, base, yaw, scale)
	local mesh = model and model:FindFirstChildWhichIsA("MeshPart")
	if model == nil or mesh == nil then
		return nil
	end
	mesh.Name = name
	mesh.Parent = parent
	model:Destroy()
	return mesh
end

-- Centres `model` on to.CFrame * offset and welds every part to `to` (unanchored, massless, no
-- collision): enemy bodies, masks, weapons.
function Models.attach(model: Model, to: BasePart, offset: CFrame)
	local box = model:GetBoundingBox()
	model:PivotTo(to.CFrame * offset * box:ToObjectSpace(model:GetPivot()))
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = false
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = to
			weld.Part1 = p
			weld.Parent = p
		end
	end
end

-- Turns off collision, queries and touches on every part of a decorative model.
function Models.ghost(model: Model)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
		end
	end
end

return Models
