{
  "name": "animal-stations",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Kit": { "$path": "src/kit" },
      "KitRoblox": { "$path": "src/kit-roblox/modules" },
      "BuildInfo": { "$path": "build-info/BuildInfo.txt" }
    },
    "ServerScriptService": {
      "Stations": {
        "$path": "src/stations",
        "Props": { "$path": "src/relay/Props.luau" }
      },
      "BuildStamp": { "$path": "src/kit-roblox/BuildStamp.server.luau" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "StationsClient": { "$path": "src/stations-client" },
        "BuildStamp": { "$path": "src/kit-roblox/BuildStamp.client.luau" }
      }
    },
    "Workspace": {
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Neutral": true,
          "Size": [12, 1, 12],
          "Transparency": 1,
          "CanCollide": false
        }
      }
    }
  }
}
