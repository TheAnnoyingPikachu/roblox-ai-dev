{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio task",
  "description": "Task contract from the blueprint (section 5). CI rejects tasks without an owner, inputs or testable acceptance criteria.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "project_id",
    "owner",
    "task_type",
    "objective",
    "inputs",
    "dependencies",
    "acceptance_criteria",
    "verification",
    "risk_level",
    "status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "owner": {
      "enum": [
        "A01",
        "A02",
        "A03",
        "A04",
        "A06",
        "A09",
        "A10",
        "A11",
        "A12",
        "A13",
        "A14",
        "A15",
        "A16"
      ]
    },
    "verifier": {
      "enum": [
        "A04",
        "A15",
        "A01",
        "CI"
      ]
    },
    "task_type": {
      "enum": [
        "research",
        "design",
        "architecture",
        "implementation",
        "test",
        "asset",
        "release",
        "infrastructure"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{3,}$"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "verification": {
      "type": "string",
      "minLength": 5
    },
    "output_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "in_progress",
        "blocked",
        "in_review",
        "rejected",
        "accepted",
        "cancelled"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
