--!strict
local T = require("./framework")
local SaveRules = require("../src/shared/SaveRules")

local describe, it, expect = T.describe, T.it, T.expect

describe("SaveRules.sanitize", function()
	it("returns defaults for missing or non-table data", function()
		local s = SaveRules.sanitize(nil)
		expect(s.coins).toBe(0)
		expect(s.tier).toBe(1)
		expect(s.pastries).toBe(0)
		expect(SaveRules.sanitize("garbage").coins).toBe(0)
	end)

	it("keeps valid values", function()
		local s = SaveRules.sanitize({ coins = 120, tier = 3, pastries = 4, saveCount = 7 })
		expect(s.coins).toBe(120)
		expect(s.tier).toBe(3)
		expect(s.pastries).toBe(4)
		expect(s.saveCount).toBe(7)
	end)

	it("clamps coins to the cap, tier to the tier count, and pastries to the cap", function()
		local s = SaveRules.sanitize({ coins = 9_999_999_999, tier = 42, pastries = 99_999 })
		expect(s.coins).toBe(1_000_000_000)
		expect(s.tier).toBe(5)
		expect(s.pastries).toBe(10_000)
	end)

	it("raises tier 0 and negative tiers to tier 1", function()
		expect(SaveRules.sanitize({ tier = 0 }).tier).toBe(1)
		expect(SaveRules.sanitize({ tier = -3 }).tier).toBe(1)
	end)

	it("rejects negative and non-numeric values", function()
		local s = SaveRules.sanitize({ coins = -5, tier = "3", pastries = 0 / 0 })
		expect(s.coins).toBe(0)
		expect(s.tier).toBe(1)
		expect(s.pastries).toBe(0)
	end)

	it("rejects infinite values", function()
		local s = SaveRules.sanitize({ coins = math.huge, pastries = -math.huge, saveCount = math.huge })
		expect(s.coins).toBe(0)
		expect(s.pastries).toBe(0)
		expect(s.saveCount).toBe(0)
	end)

	it("floors fractional values", function()
		local s = SaveRules.sanitize({ coins = 7.9, tier = 2.2, pastries = 1.5 })
		expect(s.coins).toBe(7)
		expect(s.tier).toBe(2)
		expect(s.pastries).toBe(1)
	end)

	it("drops a malformed lock", function()
		expect(SaveRules.sanitize({ lock = { jobId = "", at = 1 } }).lock).toBeNil()
		expect(SaveRules.sanitize({ lock = { jobId = "a", at = math.huge } }).lock).toBeNil()
		expect(SaveRules.sanitize({ lock = "x" }).lock).toBeNil()
	end)

	it("always writes the current schema version", function()
		expect(SaveRules.sanitize({ schemaVersion = 99 }).schemaVersion).toBe(SaveRules.SCHEMA_VERSION)
	end)
end)

describe("SaveRules round trip", function()
	it("keeps the gameplay fields through fromState, sanitize and toState", function()
		local record = SaveRules.fromState({ coins = 40, tier = 2, pastries = 3, lastBakeAt = 9 }, 5, nil)
		local state = SaveRules.toState(SaveRules.sanitize(record))
		expect(state.coins).toBe(40)
		expect(state.tier).toBe(2)
		expect(state.pastries).toBe(3)
		expect(state.lastBakeAt).toBeNil()
	end)

	it("stores the save count and lock it was given", function()
		local record = SaveRules.fromState({ coins = 0, tier = 1, pastries = 0 }, 5, { jobId = "job", at = 100 })
		expect(record.saveCount).toBe(5)
		expect(record.schemaVersion).toBe(SaveRules.SCHEMA_VERSION)
		expect(record.lock.jobId).toBe("job")
		expect(record.lock.at).toBe(100)
	end)
end)

describe("SaveRules.decideClaim", function()
	it("claims a record with no lock", function()
		expect(SaveRules.decideClaim(nil, "A", 0)).toBe("claim")
		expect(SaveRules.decideClaim(SaveRules.defaults(), "A", 0)).toBe("claim")
	end)

	it("claims a record this server already holds", function()
		local record = SaveRules.fromState({ coins = 0, tier = 1, pastries = 0 }, 1, { jobId = "A", at = 100 })
		expect(SaveRules.decideClaim(record, "A", 101)).toBe("claim")
	end)

	it("refuses a fresh lock held by another server", function()
		local record = SaveRules.fromState({ coins = 0, tier = 1, pastries = 0 }, 1, { jobId = "B", at = 100 })
		expect(SaveRules.decideClaim(record, "A", 100 + SaveRules.LOCK_STALE_SECONDS - 1)).toBe("locked")
	end)

	it("takes over a stale lock from another server", function()
		local record = SaveRules.fromState({ coins = 0, tier = 1, pastries = 0 }, 1, { jobId = "B", at = 100 })
		expect(SaveRules.decideClaim(record, "A", 100 + SaveRules.LOCK_STALE_SECONDS)).toBe("claim")
	end)
end)

describe("SaveRules.decideWrite", function()
	it("writes when there is no stored record", function()
		expect(SaveRules.decideWrite(nil, "A", 0)).toBe("write")
	end)

	it("writes over its own lock with the same save count", function()
		local record = SaveRules.fromState({ coins = 0, tier = 1, pastries = 0 }, 3, { jobId = "A", at = 1 })
		expect(SaveRules.decideWrite(record, "A", 3)).toBe("write")
	end)

	it("rejects a write while another server holds the lock", function()
		local record = SaveRules.fromState({ coins = 0, tier = 1, pastries = 0 }, 3, { jobId = "B", at = 1 })
		expect(SaveRules.decideWrite(record, "A", 3)).toBe("reject")
	end)

	it("rejects a write when stored data is newer than this server's copy", function()
		local record = SaveRules.fromState({ coins = 0, tier = 1, pastries = 0 }, 4, nil)
		expect(SaveRules.decideWrite(record, "A", 3)).toBe("reject")
	end)

	it("writes when the stored save count matches", function()
		local record = SaveRules.fromState({ coins = 0, tier = 1, pastries = 0 }, 3, nil)
		expect(SaveRules.decideWrite(record, "A", 3)).toBe("write")
	end)
end)
