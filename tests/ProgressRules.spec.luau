--!strict
local T = require("./framework")
local ProgressRules = require("../src/shared/ProgressRules")

local describe, it, expect = T.describe, T.it, T.expect
local DAY = 20_000 -- an arbitrary server day number

describe("ProgressRules levels", function()
	it("starts at level 1 and follows 40 * (level - 1)^2", function()
		expect(ProgressRules.levelFor(0)).toBe(1)
		expect(ProgressRules.levelFor(39)).toBe(1)
		expect(ProgressRules.levelFor(40)).toBe(2)
		expect(ProgressRules.levelFor(ProgressRules.xpForLevel(10))).toBe(10)
		expect(ProgressRules.levelFor(ProgressRules.xpForLevel(10) - 1)).toBe(9)
	end)

	it("caps at MAX_LEVEL and treats negative XP as zero", function()
		expect(ProgressRules.levelFor(10 ^ 9)).toBe(ProgressRules.MAX_LEVEL)
		expect(ProgressRules.levelFor(-50)).toBe(1)
	end)
end)

describe("ProgressRules matches", function()
	it("awards XP and coins for race, legs, rounds and the win", function()
		local xp, coins = ProgressRules.matchRewards({ legs = 3, roundsSurvived = 2, won = true })
		expect(xp).toBe(20 + 30 + 10 + 60)
		expect(coins).toBe(10 + 15 + 0 + 25)
	end)

	it("ignores negative or fractional counts", function()
		local xp = ProgressRules.matchRewards({ legs = -4, roundsSurvived = 1.9, won = false })
		expect(xp).toBe(20 + 5)
	end)

	it("adds totals and quest progress without changing the input", function()
		local before = ProgressRules.defaults()
		local after, xp, coins = ProgressRules.applyMatch(before, { legs = 2, roundsSurvived = 1, won = true }, DAY)
		expect(after.xp).toBe(xp)
		expect(after.coins).toBe(coins)
		expect(after.wins).toBe(1)
		expect(after.races).toBe(1)
		expect(after.legs).toBe(2)
		expect(after.quests.day).toBe(DAY)
		expect(after.quests.progress.legs).toBe(2)
		expect(after.quests.progress.wins).toBe(1)
		expect(before.xp).toBe(0)
	end)

	it("resets quest progress on a new day", function()
		local p = ProgressRules.applyMatch(ProgressRules.defaults(), { legs = 2, roundsSurvived = 0, won = false }, DAY)
		local next = ProgressRules.applyMatch(p, { legs = 1, roundsSurvived = 0, won = false }, DAY + 1)
		expect(next.quests.progress.legs).toBe(1)
	end)
end)

describe("ProgressRules daily reward", function()
	it("claims once per day and builds a streak", function()
		local p, ok, reward = ProgressRules.claimDaily(ProgressRules.defaults(), DAY)
		expect(ok).toBe(true)
		expect(reward).toBe(50)
		local _, again = ProgressRules.claimDaily(p, DAY)
		expect(again).toBe(false)
		local p2, ok2, reward2 = ProgressRules.claimDaily(p, DAY + 1)
		expect(ok2).toBe(true)
		expect(reward2).toBe(75)
		expect(p2.daily.streak).toBe(2)
		expect(p2.coins).toBe(125)
	end)

	it("resets the streak after a missed day", function()
		local p = ProgressRules.claimDaily(ProgressRules.defaults(), DAY)
		p = ProgressRules.claimDaily(p, DAY + 1)
		local p3, _, reward = ProgressRules.claimDaily(p, DAY + 3)
		expect(p3.daily.streak).toBe(1)
		expect(reward).toBe(50)
	end)

	it("pays the day-7 reward from day 7 on", function()
		expect(ProgressRules.dailyReward(7)).toBe(400)
		expect(ProgressRules.dailyReward(30)).toBe(400)
	end)
end)

describe("ProgressRules weekly reward", function()
	it("needs logins on 5 different days in the same week", function()
		local monday = 7 * 3000 - 3 -- weekOf(monday) starts a week
		expect(ProgressRules.weekOf(monday)).toBe(ProgressRules.weekOf(monday + 6))
		expect(ProgressRules.weekOf(monday + 7) - ProgressRules.weekOf(monday)).toBe(1)
		local p = ProgressRules.defaults()
		for d = 0, 3 do
			p = ProgressRules.login(p, monday + d)
			p = ProgressRules.login(p, monday + d) -- same day twice counts once
		end
		expect(ProgressRules.canClaimWeekly(p, monday + 3)).toBe(false)
		p = ProgressRules.login(p, monday + 4)
		local claimed, ok, reward = ProgressRules.claimWeekly(p, monday + 4)
		expect(ok).toBe(true)
		expect(reward).toBe(ProgressRules.WEEKLY.reward)
		local _, again = ProgressRules.claimWeekly(claimed, monday + 5)
		expect(again).toBe(false)
	end)

	it("starts over in a new week", function()
		local monday = 7 * 3000 - 3
		local p = ProgressRules.defaults()
		for d = 0, 4 do
			p = ProgressRules.login(p, monday + d)
		end
		p = ProgressRules.login(p, monday + 7)
		expect(p.week.days).toBe(1)
		expect(ProgressRules.canClaimWeekly(p, monday + 7)).toBe(false)
	end)
end)

describe("ProgressRules daily quests", function()
	it("gives three different quests, the same all day", function()
		for d = DAY, DAY + 20 do
			local qs = ProgressRules.questsFor(d)
			expect(#qs).toBe(3)
			expect(qs[1].id ~= qs[2].id and qs[2].id ~= qs[3].id and qs[1].id ~= qs[3].id).toBe(true)
			expect(ProgressRules.questsFor(d)[1].id).toBe(qs[1].id)
		end
	end)

	it("pays a finished quest once and refuses unfinished ones", function()
		local quest = ProgressRules.questsFor(DAY)[1]
		local p = ProgressRules.login(ProgressRules.defaults(), DAY)
		local _, early = ProgressRules.claimQuest(p, DAY, quest.id)
		expect(early).toBe(false)
		p.quests.progress[quest.stat] = quest.goal
		local done, ok, reward = ProgressRules.claimQuest(p, DAY, quest.id)
		expect(ok).toBe(true)
		expect(reward).toBe(quest.reward)
		local _, twice = ProgressRules.claimQuest(done, DAY, quest.id)
		expect(twice).toBe(false)
	end)

	it("refuses a quest that is not on today's list", function()
		local p = ProgressRules.login(ProgressRules.defaults(), DAY)
		local _, ok = ProgressRules.claimQuest(p, DAY, "made-up")
		expect(ok).toBe(false)
	end)
end)

describe("ProgressRules trails", function()
	it("unlocks by level and by wins", function()
		local p = ProgressRules.defaults()
		expect(ProgressRules.isUnlocked(p, "team")).toBe(true)
		expect(ProgressRules.isUnlocked(p, "sakura")).toBe(false)
		p.xp = ProgressRules.xpForLevel(3)
		expect(ProgressRules.isUnlocked(p, "sakura")).toBe(true)
		expect(ProgressRules.isUnlocked(p, "gold")).toBe(false)
		p.wins = 10
		expect(ProgressRules.isUnlocked(p, "gold")).toBe(true)
	end)

	it("buys shop trails with enough coins, once", function()
		local p = ProgressRules.defaults()
		local _, poor = ProgressRules.buyTrail(p, "lightning")
		expect(poor).toBe(false)
		p.coins = 1000
		local bought, ok = ProgressRules.buyTrail(p, "lightning")
		expect(ok).toBe(true)
		expect(bought.coins).toBe(250)
		expect(ProgressRules.isUnlocked(bought, "lightning")).toBe(true)
		local _, twice = ProgressRules.buyTrail(bought, "lightning")
		expect(twice).toBe(false)
		local _, notForSale = ProgressRules.buyTrail(p, "sakura")
		expect(notForSale).toBe(false)
	end)

	it("equips only unlocked trails", function()
		local p = ProgressRules.defaults()
		local same, ok = ProgressRules.equip(p, "rainbow")
		expect(ok).toBe(false)
		expect(same.trail).toBe("team")
		p.xp = ProgressRules.xpForLevel(18)
		local equipped, ok2 = ProgressRules.equip(p, "rainbow")
		expect(ok2).toBe(true)
		expect(equipped.trail).toBe("rainbow")
		expect(p.trail).toBe("team")
	end)
end)

describe("ProgressRules.sanitize", function()
	it("returns defaults for missing or non-table data", function()
		expect(ProgressRules.sanitize(nil).xp).toBe(0)
		expect(ProgressRules.sanitize("bad").trail).toBe("team")
	end)

	it("floors, clamps and rejects non-numbers", function()
		local p = ProgressRules.sanitize({ xp = 12.7, wins = -3, races = "x", coins = math.huge })
		expect(p.xp).toBe(12)
		expect(p.wins).toBe(0)
		expect(p.races).toBe(0)
		expect(p.coins).toBe(0)
		expect(ProgressRules.sanitize({ xp = 10 ^ 12 }).xp).toBe(ProgressRules.MAX_XP)
	end)

	it("drops unknown owned items and trails the profile has not unlocked", function()
		local p = ProgressRules.sanitize({ owned = { galaxy = true, sakura = true, fake = true }, trail = "rainbow" })
		expect(p.owned.galaxy).toBe(true)
		expect(p.owned.sakura).toBeNil()
		expect(p.owned.fake).toBeNil()
		expect(p.trail).toBe("team")
	end)

	it("keeps a valid record intact", function()
		local p = ProgressRules.applyMatch(ProgressRules.defaults(), { legs = 2, roundsSurvived = 1, won = true }, DAY)
		p = ProgressRules.claimDaily(p, DAY)
		local again = ProgressRules.sanitize(p)
		expect(again.xp).toBe(p.xp)
		expect(again.coins).toBe(p.coins)
		expect(again.daily.last).toBe(DAY)
		expect(again.quests.progress.legs).toBe(2)
	end)
end)
