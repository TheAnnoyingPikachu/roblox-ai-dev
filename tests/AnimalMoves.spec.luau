--!strict
-- The animals' moves (AnimalMoves) and the measures of their models (AnimalRig, generated by
-- tools/blender/stations/moves/rigdata.py): every species has an idle, an attack and a power attack of the game's
-- lengths, and every model has the feet and anchor points the client lifts and casts from.
local T = require("./framework")
local AnimalMoves = require("../src/shared/AnimalMoves")
local AnimalRig = require("../src/shared/AnimalRig")
local StationConfig = require("../src/shared/StationConfig")
local StationRules = require("../src/shared/StationRules")

local describe, it, expect = T.describe, T.it, T.expect

local JOINTS = { body = true, head = true, leg_fl = true, leg_fr = true, leg_bl = true, leg_br = true, tail = true }
local ANCHORS = { "nose", "crown", "horn", "trunk", "paw_l", "paw_r", "wing_l", "wing_r", "tail", "back", "chest" }

local function checkPose(pose: { [string]: { number } }, where: string)
	for joint, v in pose do
		expect(JOINTS[joint] == true).toBe(true)
		expect(#v >= 1 and #v <= 6).toBe(true)
		for _, x in v do
			if x ~= x or math.abs(x) > 1000 then
				error(`{where}: {joint} has {x}`)
			end
		end
	end
end

local function checkClip(keys: { { any } }, length: number, where: string)
	expect(keys[1][1]).toBe(0)
	expect(math.abs(keys[#keys][1] - length) < 1e-9).toBe(true)
	for i, key in keys do
		if i > 1 then
			expect(key[1] > keys[i - 1][1]).toBe(true)
		end
		checkPose(key[2], `{where} at {key[1]}`)
	end
end

describe("AnimalMoves", function()
	it("gives every species an idle, a 0.95 s attack and a 1.6 s power attack", function()
		for _, species in StationConfig.SPECIES do
			local id = species.id
			expect(AnimalMoves.IDLES[id] ~= nil).toBe(true)
			checkClip(AnimalMoves.ATTACKS[id], 0.95, `{id} attack`)
			checkClip(AnimalMoves.POWERS[id], 1.6, `{id} power`)
		end
	end)

	it("keys a variant's own power attack by its model", function()
		for kind, keys in AnimalMoves.POWERS do
			if string.sub(kind, 1, 9) == "creature_" then
				local known = false
				for _, asset in StationRules.FORGE do
					known = known or asset == kind
				end
				expect(known).toBe(true)
			else
				expect(StationConfig.species(kind) ~= nil).toBe(true)
			end
			checkClip(keys, 1.6, kind)
		end
	end)

	it("loops every idle every 4.8 s with sane numbers", function()
		for id, idle in AnimalMoves.IDLES do
			for i = 0, 47 do
				local t = i * 0.1
				local a, b = idle(t), idle(t + 4.8)
				checkPose(a, `{id} idle at {t}`)
				for joint, v in a do
					for k, x in v do
						expect(math.abs(x - b[joint][k]) < 1e-6).toBe(true)
					end
				end
			end
		end
	end)
end)

describe("AnimalRig", function()
	it("measures every animal model: its feet and its spells' anchors", function()
		for _, asset in StationRules.FORGE do
			local m = AnimalRig.MODELS[asset]
			if m == nil then
				error(`no AnimalRig entry for {asset}: run tools/blender/stations/moves/rigdata.py`)
			end
			expect(m.joints.body[1] == 0 and m.joints.body[2] == 0 and m.joints.body[3] == 0).toBe(true)
			local legs = 0
			for joint, points in m.feet do
				legs += 1
				expect(m.joints[joint] ~= nil).toBe(true)
				expect(#points >= 1).toBe(true)
				for _, p in points do
					expect(p[2] < m.joints[joint][2]).toBe(true) -- a foot is under its leg's joint
				end
			end
			expect(legs == (if m.upright or string.find(asset, "flamingo") then 2 else 4)).toBe(true)
			for _, name in ANCHORS do
				local a = m.anchors[name]
				expect(a ~= nil and m.joints[a[1]] ~= nil and #a[2] == 3).toBe(true)
			end
		end
	end)
end)
